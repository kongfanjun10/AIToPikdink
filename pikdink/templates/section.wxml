<template name="section">
  <view class="screen screen--tabs">
    <view class="title">{{section.name}}</view>
    <view class="subtitle">{{section.description}}</view>
    <view wx:if="{{categories.length}}" class="chips">
      <view class="chip {{activeCategory === '' ? 'chip--active' : ''}}" data-category="" bindtap="selectCategory">全部</view>
      <view
        wx:for="{{categories}}" wx:key="*this"
        class="chip {{activeCategory === item ? 'chip--active' : ''}}"
        data-category="{{item}}" bindtap="selectCategory"
      >{{item}}</view>
    </view>
    <content-card wx:for="{{items}}" wx:key="id" item="{{item}}" />
    <view wx:if="{{!items.length}}" class="empty">暂无内容</view>
  </view>
  <bottom-nav active="{{section.id}}" />
</template>
