.detail-title { margin-top: 18rpx; font-size: 52rpx; }
.detail-image { width: 100%; height: 380rpx; display: block; margin: 30rpx 0; border-radius: 30rpx; }
.paragraph { margin-bottom: 20rpx; line-height: 1.75; }
.primary-button { margin-top: 40rpx; }
.return-home { margin-top: 22rpx; color: #306c00; font-weight: 700; }
.preview { position: fixed; inset: 0; z-index: 20; display: flex; flex-direction: column; align-items: center; justify-content: center; background: #0f172a; }
.preview-image { width: 100%; height: 75vh; }
.preview-close { margin-top: 20rpx; background: #fff; color: #0f172a; font-size: 28rpx; }
