<view class="screen">
  <block wx:if="{{item}}">
    <view class="pill">{{item.typeName}} · {{item.category}}</view>
    <view class="title detail-title">{{item.title}}</view>
    <view class="subtitle">{{item.summary}}</view>
    <image class="detail-image" src="{{item.image}}" mode="aspectFill" bindtap="previewImage" aria-label="查看大图" />
    <view class="paragraph" wx:for="{{item.paragraphs}}" wx:key="*this">{{item}}</view>
    <button class="primary-button" bindtap="toggleFavorite">{{isFavorite ? '取消收藏' : '加入收藏'}}</button>
  </block>
  <view wx:else class="empty">
    <view>这条内容暂时不可用</view>
    <navigator class="return-home" url="/pages/home/index" open-type="reLaunch">返回首页</navigator>
  </view>
</view>
<view wx:if="{{isPreviewOpen}}" class="preview" bindtap="closePreview">
  <image class="preview-image" src="{{item.image}}" mode="aspectFit" />
  <button class="preview-close" catchtap="closePreview">关闭大图</button>
</view>
