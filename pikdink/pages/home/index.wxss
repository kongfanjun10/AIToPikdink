.top { display: flex; justify-content: space-between; align-items: center; }
.search-link { padding: 14rpx 26rpx; border-radius: 60rpx; color: #285b10; background: #e9f7d9; font-weight: 700; font-size: 26rpx; }
.hero { position: relative; height: 385rpx; margin: 34rpx 0 24rpx; overflow: hidden; border-radius: 42rpx; background: #285b10; }
.hero-image, .hero-shade { position: absolute; inset: 0; width: 100%; height: 100%; }
.hero-shade { background: linear-gradient(0deg, rgba(15, 23, 42, .90), rgba(15, 23, 42, 0) 95%); }
.hero-body { position: absolute; left: 30rpx; right: 26rpx; bottom: 28rpx; color: #fff; }
.hero-title { margin-top: 10rpx; font-size: 45rpx; font-weight: 800; }
.hero-summary { font-size: 25rpx; }
.shortcuts { display: flex; gap: 10rpx; }
.shortcut { flex: 1; text-align: center; padding: 22rpx 0; border-radius: 20rpx; color: #263b2c; font-size: 26rpx; font-weight: 700; }
.shortcut--news { background: #e0f2fe; }
.shortcut--tutorials { background: #d9f99d; }
.shortcut--courts { background: #e1f4e8; }
.shortcut--gear { background: #fce7f3; }
.shortcut--favorites { background: #eaedff; }
