<view class="bar">
  <block wx:for="{{tabs}}" wx:key="id">
    <navigator
      class="tab"
      url="/pages/{{item.id}}/index"
      open-type="redirect"
      wx:if="{{active !== item.id}}"
    >
      <text class="icon">{{item.icon}}</text>
      <text>{{item.name}}</text>
    </navigator>
    <view wx:else class="tab tab--active" aria-label="{{item.name}}，当前页面">
      <text class="icon">{{item.icon}}</text>
      <text>{{item.name}}</text>
    </view>
  </block>
</view>
