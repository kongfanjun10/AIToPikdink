.bar {
  position: fixed;
  z-index: 10;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  padding: 8rpx;
  border-radius: 80rpx;
  background: #fff;
  box-shadow: 0 6rpx 36rpx rgba(15, 23, 42, .15);
}
.tab {
  flex: 1;
  min-width: 0;
  min-height: 88rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  color: #536477;
  font-size: 22rpx;
}
.tab--active { border-radius: 60rpx; background: #e9f7d9; color: #285b10; font-weight: 700; }
.icon { font-size: 34rpx; line-height: 1.05; margin-bottom: 4rpx; }
